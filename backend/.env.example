# Server
PORT=3001
NODE_ENV=development

# Microsoft Entra ID (Azure AD) - App Registration
# Create at https://portal.azure.com → Azure Active Directory → App registrations
TENANT_ID=your-tenant-id-here
CLIENT_ID=your-client-id-here
CLIENT_SECRET=your-client-secret-here

# Power BI Service
# Workspace ID: found in the URL when viewing your workspace
# Dataset ID: found via Power BI REST API or in the URL of dataset settings
POWERBI_WORKSPACE_ID=your-workspace-id-here
POWERBI_DATASET_ID=your-dataset-id-here

# Data behavior
# Set to "true" to use mock data regardless of PBI connection status (useful in development)
USE_MOCK_DATA=true

# Cache TTL in seconds (how long query results are cached before re-fetching from Power BI)
CACHE_TTL_SECONDS=60

# CORS - allowed frontend origin
CORS_ORIGIN=http://localhost:5173
